# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Your verified sending domain on Resend (e.g. uholawclub.in)
# Without this, emails can only be sent to the Resend account owner.
RESEND_VERIFIED_DOMAIN=yourdomain.com

# Upstash Redis — used for rate limiting (https://upstash.com)
# Leave as-is for local dev — rate limiting will be skipped automatically.
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
